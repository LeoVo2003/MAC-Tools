# Copy thanh ".env" roi dien thong tin that
# KHONG commit file .env

WPM_USERNAME=your_wpm_admin_username
WPM_PASSWORD=your_wpm_admin_password

# false = mo Chrome de xem/debug (khuyen nghi)
# true  = chay an (chi khi da on dinh)
HEADLESS=false

# Toc do: fast (mac dinh trong code) | normal | slow
SPEED=fast

# Thu muc tai backup (mac dinh: %USERPROFILE%\Downloads\Auto F Package)
# DOWNLOAD_DIR=C:\Users\YourName\Downloads\Auto F Package

# Optional: duong dan Chrome neu khong tu tim duoc
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: dung profile Chrome that (fallback khi site van chan automation)
# CHROME_USER_DATA_DIR=C:\Users\YourName\AppData\Local\Google\Chrome\User Data\AutoFPackage

PORT=3847
