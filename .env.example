# Copy to ".env" — KHÔNG commit file .env

# Server
PORT=3847
NODE_ENV=development
OPEN_BROWSER=true

# Production / VPS:
# NODE_ENV=production
# OPEN_BROWSER=false
# HEADLESS=true

HEADLESS=false
SPEED=fast

# SESSION / mã hóa WPM per-user (đổi trên production)
SESSION_SECRET=change-me-session-secret
APP_SECRET=change-me-app-secret

# Cookie secure khi HTTPS
# COOKIE_SECURE=true

# Số job Chrome chạy song song (mặc định 4)
MAX_CONCURRENT_JOBS=4

# Admin seed (chỉ tạo khi data/users.json trống)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Acc team (tạo nếu chưa có) — chỉ Run + Backup files
WEB_USER=web
WEB_PASS=web@123

# Chrome
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# DOWNLOAD_DIR=/var/fugt/downloads
