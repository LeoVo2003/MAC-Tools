# =============================================================================
# F User Guide Tool — .env
# Copy thành ".env" — KHÔNG commit file .env
# =============================================================================

# --- Server ---
PORT=3847
# turbo | fast | normal | slow — turbo = nhanh nhất (mặc định Docker)
SPEED=turbo

# -----------------------------------------------------------------------------
# A) LOCAL (Windows) — mặc định khi npm start trên máy
# -----------------------------------------------------------------------------
NODE_ENV=development
OPEN_BROWSER=true
HEADLESS=false
MAX_CONCURRENT_JOBS=4
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_USER_DATA_DIR=
# DOWNLOAD_DIR=

# -----------------------------------------------------------------------------
# B) VPS / Docker (user-guide.kietvh.io.vn) — BẬT block này, TẮT block A ở trên
# -----------------------------------------------------------------------------
# NODE_ENV=production
# OPEN_BROWSER=false
# HEADLESS=false
# Live Chrome. false = tắt hẳn.
# snapshot (mặc định) = chụp JPEG định kỳ qua Socket — nhẹ, headless OK.
# screencast = CDP stream nhanh hơn snapshot; novnc = x11vnc cũ (nặng).
# CHROME_LIVE=true
# CHROME_LIVE=false
# CHROME_LIVE_MODE=snapshot
# LIVE_SNAPSHOT_MS=1500
# LIVE_SNAPSHOT_QUALITY=50
# CHROME_LIVE_MODE=novnc
# CHROME_LIVE_IDLE_MS=120000
# Idle 0.3 CPU; Fill/Run/Mở Live → 2.5 (cần mount docker.sock). Hạ lại khi hết việc + Live đóng.
# Live tắt → Chrome headless (nhanh). Muốn xem: bấm Mở Live trước Fill/Run.
# DOCKER_CPU_SCALE=true
# DOCKER_CPU_IDLE=0.3
# DOCKER_CPU_LIVE=2.5
# DISPLAY=:99
# CHROME_PATH=/usr/bin/chromium
# CHROME_NO_SANDBOX=true
# MAX_CONCURRENT_JOBS=1
# DOWNLOAD_DIR=/data/downloads
# NOVNC_PATH=/usr/share/novnc
# COOKIE_SECURE=auto
# BACKUP_RETENTION_DAYS=7
# TZ=Asia/Ho_Chi_Minh

# --- Session / mã hóa WPM (BẮT BUỘC đổi trên production) ---
SESSION_SECRET=change-me-session-secret
APP_SECRET=change-me-app-secret

# --- Admin (leo.vo@macusaone.com luôn admin). Thêm email, cách nhau bởi dấu phẩy ---
# ADMIN_EMAILS=other@macusaone.com

# --- Backup / health ---
BACKUP_RETENTION_DAYS=7
# JOB_STALE_MINUTES=45
# DISK_WARN_MB=8000
