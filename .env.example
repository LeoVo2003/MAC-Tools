# =============================================================================
# F User Guide Tool — .env
# Copy thành ".env" — KHÔNG commit file .env
# =============================================================================

# --- Server ---
PORT=3847
# turbo | fast | normal | slow — turbo = nhanh nhất (mặc định Docker)
SPEED=turbo
# 2.1: tạo user WP bằng HTTP (cookie sau Quick Login). 0 = chỉ Chrome.
USE_HTTP_STEPS=1

# -----------------------------------------------------------------------------
# A) LOCAL (Windows) — mặc định khi npm start trên máy
# -----------------------------------------------------------------------------
NODE_ENV=development
OPEN_BROWSER=true
HEADLESS=false
# 0 = không giới hạn số job đồng thời; số nguyên dương = giới hạn do admin chọn.
MAX_CONCURRENT_JOBS=0
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_USER_DATA_DIR=
# DOWNLOAD_DIR=

# -----------------------------------------------------------------------------
# B) VPS / Docker (user-guide.kietvh.io.vn) — BẬT block này, TẮT block A ở trên
# -----------------------------------------------------------------------------
# NODE_ENV=production
# OPEN_BROWSER=false
# HEADLESS=false
# Live Chrome. false = tắt hẳn.
# snapshot (mặc định) = chụp JPEG theo log qua Socket, headless OK.
# screencast = CDP stream nhanh hơn snapshot; novnc = x11vnc cũ (nặng).
# CHROME_LIVE=true
# CHROME_LIVE=false
# CHROME_LIVE_MODE=snapshot
# LIVE_SNAPSHOT_QUALITY=50
# CHROME_LIVE_MODE=novnc
# CHROME_LIVE_IDLE_MS=120000
# CPU không đặt quota; Chrome tự chọn GPU theo phần cứng có sẵn.
# DISPLAY=:99
# CHROME_PATH=/usr/bin/chromium
# CHROME_NO_SANDBOX=true
# MAX_CONCURRENT_JOBS=0
# DOWNLOAD_DIR=/data/downloads
# NOVNC_PATH=/usr/share/novnc
# COOKIE_SECURE=auto
# BACKUP_RETENTION_DAYS=7
# TZ=Asia/Ho_Chi_Minh

# --- Session / mã hóa WPM (BẮT BUỘC đổi trên production) ---
SESSION_SECRET=change-me-session-secret
APP_SECRET=change-me-app-secret

# --- Admin (leo.vo@macusaone.com luôn admin). Thêm email, cách nhau bởi dấu phẩy ---
# ADMIN_EMAILS=other@macusaone.com

# --- Backup / health ---
BACKUP_RETENTION_DAYS=7
# JOB_STALE_MINUTES=45
# DISK_WARN_MB=8000

# --- QR Tool → qr.macmarketing.us (WordPress REST API) ---
# Tạo Application Password: wp-admin → Users → Profile → Application Passwords
# Điền vào .env trên máy mày, KHÔNG gửi qua chat. Server chỉ đọc từ env.
QR_WP_BASE=https://qr.macmarketing.us
QR_WP_USER=
QR_WP_APP_PASSWORD=
# Elementor template ID cho QR landing page
QR_TEMPLATE_ID=2806
# --- QR Bridge: mu-plugin tạm (tự cài trước job, tự xóa sau job) ---
# Nếu không cấu hình SFTP, tool sẽ dùng template cache (cần export tay 1 lần).
QR_SFTP_HOST=
QR_SFTP_PORT=22
QR_SFTP_USER=
QR_SFTP_PASSWORD=
# Đường dẫn tuyệt đối tới wp-content/mu-plugins trên hosting
QR_SFTP_PATH=/public_html/wp-content/mu-plugins
