# =============================================================================
# F User Guide Tool — .env
# Copy thành ".env" — KHÔNG commit file .env
# =============================================================================

# --- Server ---
PORT=3847
SPEED=fast

# -----------------------------------------------------------------------------
# A) LOCAL (Windows) — mặc định khi npm start trên máy
# -----------------------------------------------------------------------------
NODE_ENV=development
OPEN_BROWSER=true
HEADLESS=false
MAX_CONCURRENT_JOBS=4
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_USER_DATA_DIR=
# DOWNLOAD_DIR=

# -----------------------------------------------------------------------------
# B) VPS / Docker (user-guide.kietvh.io.vn) — BẬT block này, TẮT block A ở trên
# -----------------------------------------------------------------------------
# NODE_ENV=production
# OPEN_BROWSER=false
# HEADLESS=false
# Live Chrome (noVNC). false = tắt hẳn tính năng (tiết kiệm nhất khi team không cần xem).
# Khi true: x11vnc/websockify chỉ chạy lúc user bấm Mở Live — đóng Live thì tắt.
# CHROME_LIVE=true
# CHROME_LIVE=false
# CHROME_LIVE_MODE=novnc
# CHROME_LIVE_IDLE_MS=120000
# Idle 0.3 CPU; Fill/Run/Mở Live → 1.5 (cần mount docker.sock). Hạ lại khi hết việc + Live đóng.
# DOCKER_CPU_SCALE=true
# DOCKER_CPU_IDLE=0.3
# DOCKER_CPU_LIVE=1.5
# DISPLAY=:99
# CHROME_PATH=/usr/bin/chromium
# CHROME_NO_SANDBOX=true
# MAX_CONCURRENT_JOBS=1
# DOWNLOAD_DIR=/data/downloads
# NOVNC_PATH=/usr/share/novnc
# COOKIE_SECURE=auto
# BACKUP_RETENTION_DAYS=7
# TZ=Asia/Ho_Chi_Minh

# --- Session / mã hóa WPM (BẮT BUỘC đổi trên production) ---
SESSION_SECRET=change-me-session-secret
APP_SECRET=change-me-app-secret

# --- Admin (leo.vo@macusaone.com luôn admin). Thêm email, cách nhau bởi dấu phẩy ---
# ADMIN_EMAILS=other@macusaone.com

# --- Backup / health ---
BACKUP_RETENTION_DAYS=7
# JOB_STALE_MINUTES=45
# DISK_WARN_MB=8000
