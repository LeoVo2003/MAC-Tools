# Copy to ".env" — KHÔNG commit file .env

# Server
PORT=3847
NODE_ENV=development
OPEN_BROWSER=true

# Production / VPS:
# NODE_ENV=production
# OPEN_BROWSER=false
# HEADLESS=true

HEADLESS=false
SPEED=fast

# SESSION / mã hóa WPM (đổi trên production — chuỗi dài ngẫu nhiên)
SESSION_SECRET=change-me-session-secret
APP_SECRET=change-me-app-secret

# Cookie secure khi HTTPS
# COOKIE_SECURE=true

# Số job Chrome chạy song song (mặc định 4)
MAX_CONCURRENT_JOBS=4

# Admin = email WPM (leo.vo@macusaone.com luôn admin). Thêm email:
# ADMIN_EMAILS=other@macusaone.com

# Chrome
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# DOWNLOAD_DIR=/var/fugt/downloads
